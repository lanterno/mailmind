{
  "about": "Whom a stored message went to, from its To and Cc as the store keeps them: one decoded text, a space between the two. Each case is the text, and each person it names once, in order, as [name, address] with null for no name. Read by tests/unit/kernel/test_addressees.py and core/crates/mm-kernel/tests/addressees.rs, so both servers name them the same.",
  "cases": [
    {"why": "a To of two", "text": "Lin Mori <lin@example.test>, Ada Park <ada@example.test>",
     "people": [["Lin Mori", "lin@example.test"], ["Ada Park", "ada@example.test"]]},
    {"why": "a To and a Cc, a space between them", "text": "Lin Mori <lin@example.test> Bea Stone <bea@example.test>",
     "people": [["Lin Mori", "lin@example.test"], ["Bea Stone", "bea@example.test"]]},
    {"why": "a bare To and a bare Cc", "text": "lin@example.test bea@example.test",
     "people": [[null, "lin@example.test"], [null, "bea@example.test"]]},
    {"why": "a bare To and a named Cc", "text": "lin@example.test \"Bea Stone\" <bea@example.test>",
     "people": [[null, "lin@example.test"], ["Bea Stone", "bea@example.test"]]},
    {"why": "a named To and a bare Cc", "text": "Lin <lin@example.test> bea@example.test",
     "people": [["Lin", "lin@example.test"], [null, "bea@example.test"]]},
    {"why": "a quoted name's comma", "text": "\"Mori, Lin\" <lin@example.test>, cy@example.test",
     "people": [["Mori, Lin", "lin@example.test"], [null, "cy@example.test"]]},
    {"why": "a decoded name's comma, which no quote guards", "text": "Acme, Inc. <billing@example.test>",
     "people": [["Acme, Inc.", "billing@example.test"]]},
    {"why": "each address once, whatever its case", "text": "Lin <lin@example.test>, LIN@example.test Lin Mori <Lin@Example.test>",
     "people": [["Lin", "lin@example.test"]]},
    {"why": "a group's name and its end", "text": "Team: a@example.test, b@example.test; c@example.test",
     "people": [[null, "a@example.test"], [null, "b@example.test"], [null, "c@example.test"]]},
    {"why": "nobody named", "text": "undisclosed-recipients:;", "people": []},
    {"why": "a comment, nested", "text": "Lin (work (mostly)) <lin@example.test>", "people": [["Lin", "lin@example.test"]]},
    {"why": "an escaped quote", "text": "\"Lin \\\"LJ\\\" Mori\" <lin@example.test>", "people": [["Lin \"LJ\" Mori", "lin@example.test"]]},
    {"why": "an address written as its own name", "text": "lin@example.test <lin@example.test>",
     "people": [["lin@example.test", "lin@example.test"]]},
    {"why": "an empty angle, and a name with no address", "text": "Nobody <>, Lin <lin@example.test>, Sam",
     "people": [["Lin", "lin@example.test"]]},
    {"why": "an angle left open", "text": "Lin < lin@example.test", "people": [["Lin", "lin@example.test"]]},
    {"why": "a quote left open", "text": "Lin <lin@example.test> \"Bea <bea@example.test>", "people": [["Lin", "lin@example.test"]]},
    {"why": "a name in other scripts", "text": "Zoë Ångström <zoe@example.test>, 山田 太郎 <taro@example.test>",
     "people": [["Zoë Ångström", "zoe@example.test"], ["山田 太郎", "taro@example.test"]]},
    {"why": "a tagged address", "text": "ada+news@example.test", "people": [[null, "ada+news@example.test"]]},
    {"why": "what Python counts as space and Rust's whitespace alone doesn't", "text": "lin@example.test\u001cbea@example.test",
     "people": [[null, "lin@example.test"], [null, "bea@example.test"]]},
    {"why": "an empty name", "text": "\"\" <lin@example.test>, \" \" <bea@example.test>",
     "people": [[null, "lin@example.test"], [null, "bea@example.test"]]},
    {"why": "nothing", "text": "", "people": []},
    {"why": "nothing stored", "text": null, "people": []}
  ]
}
