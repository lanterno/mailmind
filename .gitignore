# === Local secrets & per-user config — never commit ===
mailmind.config.json*

# === Learned rules (personal keep/block lists; regenerated at runtime) ===
mailmind_rules.json

# === Temp files a crash can leave mid-write (copies of the files above) ===
.cfg-*.tmp
.rules-*.tmp
.views-*.tmp

# === Local data & caches (regenerated) ===
mailmind.db
mailmind.db-shm
mailmind.db-wal
mailmind_views.json
*.sqlite
*.db-journal
*.jsonl

# === Logs ===
*.log
*.log.*

# === Backups & screenshots (may contain real mail) ===
backups/
*.db
*.db-shm
*.db-wal
.redesign_backup/
screenshots/
mm-*.png
*.bak-*

# === Python ===
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# === macOS ===
.DS_Store

# the frontend's build
web/node_modules/
mailmind/http/dist/
