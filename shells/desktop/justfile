# The desktop shell: Tauri around the web shell's page, with the core running natively in the app's process. See
# CLAUDE.md here. Run from the repo root as `just desktop <recipe>`. Paths are from this file's folder.
# Building on Linux needs WebKitGTK's development packages; on Windows, WebView2 (part of Windows 10 and 11).

here := source_directory()
web := here / "../web"

_default:
    @just --justfile "{{source_file()}}" --unsorted --list

# The page, then the app in release, unbundled: core/target/release/mailmind-desktop (.exe on Windows)
build: _deps
    cd "{{web}}" && npx vite build --mode desktop
    cd "{{here}}" && npx tauri build --no-bundle

# The app in release, bundled for this system (an .app and a .dmg on macOS), under core/target/release/bundle
bundle: _deps
    cd "{{web}}" && npx vite build --mode desktop
    cd "{{here}}" && npx tauri build

# The app in debug, on the web shell's dev server (started for it), with the page's devtools
dev: _deps
    cd "{{here}}" && npx tauri dev

# Formatting, and clippy with warnings as errors, on the app's Rust
check: _deps
    cd "{{web}}" && npx vite build --mode desktop
    cd "{{here}}/src-tauri" && cargo fmt --check && cargo clippy -- -D warnings

# Launch the release app, scroll its list nine tenths down, and exit 0 once rows came there (CI runs it on each system)
smoke: build
    #!/usr/bin/env bash
    set -euo pipefail
    bin="{{here}}/../../core/target/release/mailmind-desktop"
    if [ -f "$bin.exe" ]; then bin="$bin.exe"; fi
    run=()
    # Five minutes at most: a list that never scrolls must not hold a CI job for its whole hour.
    if command -v timeout >/dev/null; then run=(timeout 300); elif command -v perl >/dev/null; then run=(perl -e 'alarm shift; exec @ARGV' 300); fi
    # Linux CI has no display: a virtual one, in which the window is shown and its page renders.
    if [ "$(uname)" = Linux ] && [ -z "${DISPLAY:-}" ]; then run+=(xvfb-run -a); fi
    MAILMIND_MEASURE=scroll ${run[@]+"${run[@]}"} "$bin"
    echo "smoke: the list opened and scrolled nine tenths down"

# Launch to first rows and idle memory (app, WebContent and Networking), on the release .app (macOS)
[macos]
measure runs="5": _deps
    cd "{{web}}" && npx vite build --mode desktop
    cd "{{here}}" && npx tauri build --bundles app
    cd "{{here}}" && node scripts/measure.mjs {{runs}}

# node_modules from the lockfiles, here and in the web shell, when missing or older than them
_deps:
    cd "{{here}}" && (test node_modules/.package-lock.json -nt package-lock.json || npm ci --no-audit --no-fund)
    cd "{{web}}" && (test node_modules/.package-lock.json -nt package-lock.json || npm ci --no-audit --no-fund)
