# The Apple shell: one SwiftUI app for iPhone, iPad and Mac over the Rust core. See CLAUDE.md here.
# Run from the repo root as `just apple <recipe>`. Paths are from this file's folder, wherever just runs.

here := source_directory()
core := here / "../../core"
out := here / "build"
targets := "aarch64-apple-ios aarch64-apple-ios-sim aarch64-apple-darwin"

_default:
    @just --justfile "{{source_file()}}" --unsorted --list

# The core for Apple, then the Xcode project, then the app for the iOS simulator, iOS devices and macOS (unsigned)
build: xcframework project
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{here}}"
    # By target and SDK rather than a destination: a destination needs the iOS platform (and its simulator runtime)
    # installed, and building needs only the SDK.
    for sdk in iphonesimulator iphoneos; do
        xcodebuild -quiet -project MailMind.xcodeproj -target MailMind-iOS -configuration Release -sdk "$sdk" \
            SYMROOT="$PWD/build/ios" OBJROOT="$PWD/build/ios-obj" CODE_SIGNING_ALLOWED=NO build
    done
    xcodebuild -quiet -project MailMind.xcodeproj -scheme MailMind-macOS -configuration Release -destination 'generic/platform=macOS' \
        -derivedDataPath build/DerivedData CODE_SIGNING_ALLOWED=NO build
    echo "built: build/ios/Release-iphonesimulator/MailMind.app, build/ios/Release-iphoneos/MailMind.app"
    echo "built: build/DerivedData/Build/Products/Release/MailMind.app"

# The core as release static libraries for iPhone, the iOS simulator and Mac, in build/MailMindCore.xcframework
xcframework:
    #!/usr/bin/env bash
    set -euo pipefail
    # rustup's env file, where rustup put one. Sourcing a missing file ends bash at once, `|| true` or not.
    if [ -f "$HOME/.cargo/env" ]; then . "$HOME/.cargo/env"; fi
    # The core, and the C inside it (SQLCipher), are compiled for the same lowest OS the app runs on: project.yml's.
    export IPHONEOS_DEPLOYMENT_TARGET="$(sed -n 's/^ *iOS: *"\(.*\)"$/\1/p' "{{here}}/project.yml")"
    export MACOSX_DEPLOYMENT_TARGET="$(sed -n 's/^ *macOS: *"\(.*\)"$/\1/p' "{{here}}/project.yml")"
    test -n "$IPHONEOS_DEPLOYMENT_TARGET" -a -n "$MACOSX_DEPLOYMENT_TARGET"
    cd "{{core}}"
    libs=()
    for target in {{targets}}; do
        # Only the static library: the cdylib and rlib the crate also declares are not needed here.
        cargo rustc -q --release -p mm-ffi --lib --crate-type staticlib --target "$target"
        libs+=(-library "target/$target/release/libmailmind_core.a" -headers "{{out}}/headers")
    done
    mkdir -p "{{out}}/headers"
    cp "{{here}}/Generated/MailMindCoreFFI.h" "{{out}}/headers/"
    # Xcode finds a module only by this name.
    cp "{{here}}/Generated/MailMindCoreFFI.modulemap" "{{out}}/headers/module.modulemap"
    /bin/rm -rf "{{out}}/MailMindCore.xcframework"
    xcodebuild -create-xcframework "${libs[@]}" -output "{{out}}/MailMindCore.xcframework" >/dev/null
    echo "built: build/MailMindCore.xcframework"

# MailMind.xcodeproj from project.yml (generated, never committed)
project:
    cd "{{here}}" && xcodegen generate --quiet

# The list model's tests, on macOS
test: xcframework project
    cd "{{here}}" && xcodebuild -quiet -project MailMind.xcodeproj -scheme MailMind-macOS -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath build/DerivedData CODE_SIGNING_ALLOWED=NO test

# The hosted tests (AppTests): the Mac app itself as their host, its real menu bar and its window key, on fictional
# mail (AppTests/hosted_home.py: fake servers on loopback, a temp home, a key made for the run, a keychain stand-in).
# They take the screen and the keyboard, so they run in lane B, CI's macOS runners, and refuse a person's Mac; a VM
# or a spare Mac sets MAILMIND_LANE_B=1. The run's results: build/hosted.xcresult
test-hosted: xcframework project
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "${CI:-}" != true ] && [ "${MAILMIND_LANE_B:-}" != 1 ]; then
        echo "The hosted tests take this Mac's screen and keyboard: they run on CI (lane B), or with MAILMIND_LANE_B=1" \
            "on a VM or a spare Mac. Locally, build them with xcodebuild build-for-testing -scheme MailMindAppTests." >&2
        exit 2
    fi
    cd "{{here}}"
    xcodebuild -quiet -project MailMind.xcodeproj -scheme MailMindAppTests -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath build/DerivedData CODE_SIGNING_ALLOWED=NO build-for-testing
    /bin/rm -rf build/hosted.xcresult
    cd ../..
    uv run python shells/apple/AppTests/hosted_home.py -- \
        xcodebuild -project shells/apple/MailMind.xcodeproj -scheme MailMindAppTests \
        -destination 'platform=macOS,arch=arm64' -derivedDataPath shells/apple/build/DerivedData \
        -resultBundlePath shells/apple/build/hosted.xcresult -test-timeouts-enabled YES \
        -default-test-execution-time-allowance 180 CODE_SIGNING_ALLOWED=NO test-without-building

# The Mac app as a person runs it: on MailMind's data folder in Application Support and the login Keychain, so your
# own mail (`just apple demo` runs it on fictional mail)
run: build
    "{{here}}/build/DerivedData/Build/Products/Release/MailMind.app/Contents/MacOS/MailMind"

# The shell's budgets on this Mac, the cost of crossing into the core, and a system web view's memory
measure: build
    "{{here}}/Measure/measure.sh"

# Before a release: measure the shell, then on the demo home, and judge each number against budgets.toml's [apple].
# Over a limit by no more than its tolerance, the release goes and an issue is opened; past that, it stops (exit 1)
budgets: build
    "{{here}}/Measure/measure.sh"
    cd "{{here}}/../.." && uv run python "{{here}}/Measure/demo_home.py" \
        "{{here}}/build/DerivedData/Build/Products/Release/MailMind.app/Contents/MacOS/MailMind" --measure
    cd "{{here}}/../.." && uv run python tests/support/budgets.py judge apple "{{here}}/build/measure/budgets.txt"

# The Mac app, then the iPhone app in a simulator (`smoke mac`, `smoke ios`): each jumps nine tenths down its list
# and waits for mail in the rows there
smoke which="all": build
    "{{here}}/Measure/smoke.sh" {{which}}

# ── packaging and updates: see docs/releasing.md ──────────────────────────────

# The Mac app's icon: Icon/icon.swift draws every size into Icon/Assets.xcassets (commit the images on their own)
icon:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "{{out}}"
    xcrun swiftc -O "{{here}}/Icon/icon.swift" -o "{{out}}/icon"
    "{{out}}/icon" "{{here}}/Icon/Assets.xcassets"

# Meadow's typefaces: Fonts/fonts.py joins the page's (web/assets/fonts) into one file a face in Fonts (commit the
# fonts on their own). fontTools, pinned here, reads and writes them; nothing else needs it
fonts:
    uv run --no-project --with fonttools==4.68.0 --with brotli==1.2.1 python -I "{{here}}/Fonts/fonts.py" \
        "{{here}}/../../web/assets/fonts" "{{here}}/Fonts"

# The Mac app to hand to someone, into build/release: universal, signed ad hoc under the hardened runtime, in a .dmg,
# with the appcast signed with the owner's update key. Prints the `gh release create` command; never publishes
release:
    "{{here}}/Release/release.sh"

# The release recipe end to end with a throwaway update key, never the login Keychain: the .dmg mounts, the app in it is
# universal and its signature verifies, and its Info.plist and the appcast say what they should
release-check:
    "{{here}}/Release/check.sh"

# ── the app over the core in its own process ──────────────────────────────────

# The API's Swift types, Sources/Client/API.gen.swift, from the routes' schemas, as `just gen-api` writes the page's
gen-api:
    {{just_executable()}} --justfile "{{source_file()}}" _swift-api "{{here}}/Sources/Client/API.gen.swift"

# Fail when Sources/Client/API.gen.swift no longer matches the routes' schemas (`just verify` runs it)
check-api:
    #!/usr/bin/env bash
    set -euo pipefail
    fresh="$(mktemp -d)"
    trap '/bin/rm -rf "$fresh"' EXIT
    {{just_executable()}} --justfile "{{source_file()}}" _swift-api "$fresh/API.gen.swift"
    if ! cmp -s "$fresh/API.gen.swift" "{{here}}/Sources/Client/API.gen.swift"; then
        echo "shells/apple/Sources/Client/API.gen.swift doesn't match the server's schemas: run just apple gen-api, and review the diff" >&2
        exit 1
    fi

# The Swift types written to `out`: tests/support/openapi_doc.py writes the OpenAPI document, Generator/swift_api.py reads it
_swift-api out:
    #!/usr/bin/env bash
    set -euo pipefail
    doc="$(mktemp -d)"
    trap '/bin/rm -rf "$doc"' EXIT
    cd "{{here}}/../.."
    uv run python tests/support/openapi_doc.py "$doc/openapi.json"
    uv run python "{{here}}/Generator/swift_api.py" "$doc/openapi.json" "{{out}}"

# The Mac app on fictional mail (`just demo`'s world): fake mail servers and the fake Claude API on loopback, a temp
# home with a key of its own and a file in the login Keychain's place. `demo smoke` waits for the inbox's rows and
# quits; `demo measure` times launch to first rows and idle memory; `demo picture` has the app draw its window, light
# and dark, into build/screenshots/window. Nothing of yours is read or changed.
demo mode="": build
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{here}}/../.."
    app="{{here}}/build/DerivedData/Build/Products/Release/MailMind.app/Contents/MacOS/MailMind"
    case "{{mode}}" in
        "") uv run python "{{here}}/Measure/demo_home.py" "$app" ;;
        smoke|measure|picture) uv run python "{{here}}/Measure/demo_home.py" "$app" "--{{mode}}" ;;
        *) echo "just apple demo [smoke|measure|picture]" >&2; exit 2 ;;
    esac
