<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac app's entitlements under the hardened runtime. An ad-hoc signature has no Team ID, and the runtime's library
  validation loads only frameworks signed by Apple or by the app's own team, so it would refuse Sparkle.framework and
  the app would not start. Once the app is signed with a Developer ID (#42), the app and Sparkle share a Team ID:
  remove this then.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
